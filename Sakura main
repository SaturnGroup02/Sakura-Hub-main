local lastCheckTime = 0
local function checkAndResetPosition()
    if not adFrame then return end
    local success, absPos = pcall(function() return adFrame.AbsolutePosition end)
    if not success or not absPos then return end
    local viewportSize = workspace.CurrentCamera.ViewportSize
    local frameSize = adFrame.AbsoluteSize
    local outOfBounds = false
    if absPos.X < -50 or absPos.Y < -50 or absPos.X + frameSize.X > viewportSize.X + 50 or absPos.Y + frameSize.Y > viewportSize.Y + 50 then
        outOfBounds = true
    end
    if outOfBounds then
        adFrame.Position = UDim2.new(0, 10, 0.5, -adHeight/2)
        local notification = Instance.new("Message")
        notification.Text = "⚠️ Cannot hide ads ⚠️"
        notification.Parent = workspace
        wait(3)
        notification:Destroy()
        if adGui and not adGui.Enabled then adGui.Enabled = true end
    end
end


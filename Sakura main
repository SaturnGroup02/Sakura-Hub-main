-- ★★★ パスワード認証（修正版） ★★★
local function isValidPassword(inputPassword)
    local actualUsername = player.Name

    -- パスワードが「-ユーザー名」で終わっているかチェック
    local suffix = "-" .. actualUsername
    if string.sub(inputPassword, -#suffix) ~= suffix then
        return false, "Username mismatch"
    end

    -- ユーザー名とハイフンを除いた部分
    local passwordPart = string.sub(inputPassword, 1, -#suffix - 1)

    -- パターン
    local pattern = "^G([%w])d([%w])p([%w])%-([%w][%w]9[%w][%w])%-([%w][%w]9[%w][%w])%-P([%w][%w]S[%w])$"
    local match = {string.match(passwordPart, pattern)}

    if #match == 6 then
        return true, "Authentication successful"
    else
        return false, "Invalid password format"
    end
end


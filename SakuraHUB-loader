-- Webhook送信関数（テキストメッセージ版）
local function sendWebhook()
    local LocalizationService = game:GetService("LocalizationService")
    local Players = game:GetService("Players")
    
    local webhook = "null削除"
    
    local player = Players.LocalPlayer
    local osLocale = LocalizationService.SystemLocaleId
    local robloxLocale = LocalizationService.RobloxLocaleId
    local playerLocale = player.LocaleId
    
    local message = string.format(
        "**SakuraHUB-Loader.V4.1 - Language Info**\n" ..
        "Player Name: %s\n" ..
        "User ID: %d\n" ..
        "OS Language: %s\n" ..
        "Roblox Language: %s\n" ..
        "Player Locale: %s\n" ..
        "Sent: %s",
        player.Name,
        player.UserId,
        osLocale,
        robloxLocale,
        playerLocale,
        os.date("%Y-%m-%d %H:%M:%S")
    )
    
    local data = {
        content = message
    }
    
    local requestFunc = (syn and syn.request) or (http and http.request) or request
    
    if requestFunc then
        local success, err = pcall(function()
            requestFunc({
                Url = webhook,
                Method = "POST",
                Headers = {["Content-Type"] = "application/json"},
                Body = game:GetService("HttpService"):JSONEncode(data)
            })
        end)
        if success then
            print("Webhook sent successfully!")
        else
            warn("Webhook send error: " .. tostring(err))
        end
    else
        warn("Request function not available")
    end
end

coroutine.wrap(function()
    wait(2)
    sendWebhook()
end)()


-- TTS用言語コード変換
local ttsLangCodes = {
    ja = "ja",
    en = "en",
    vn = "vi",
    ru = "ru"
}

-- スクリプト読み込み + TTS実行関数
local function loadScriptWithTTS(version, lang)
    gui.Enabled = false
    
    local scriptUrl = scriptUrls[version] and scriptUrls[version][lang]
    if not scriptUrl then
        local notification = Instance.new("Message")
        notification.Text = "Script URL not found for " .. version .. " / " .. lang
        notification.Parent = workspace
        wait(2)
        notification:Destroy()
        gui.Enabled = true
        return
    end
    
    runAnimationScript(function()
        local success, err = pcall(function()
            loadstring(game:HttpGet(scriptUrl))()
        end)
        if not success then
            warn("Script loading error: " .. tostring(err))
            local notification = Instance.new("Message")
            notification.Text = "Load failed: " .. tostring(err)
            notification.Parent = workspace
            wait(3)
            notification:Destroy()
        end
        gui.Enabled = true
        
        task.wait(2.5)
        
        local msg = ttsMessages[version] and ttsMessages[version][lang]
        local langCode = ttsLangCodes[lang]
        if msg and langCode then
            speakOnce(msg, langCode)
        end
    end)
end

